{
    "name": "blove-krack",
    "version": "1.0.0",
    "description": "BLOVE KRACK - Next-Generation Web3 Gaming & Rewards Platform",
    "main": "server/server.js",
    "scripts": {
        "start": "node server/server.js",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "prod": "docker compose up -d --build",
        "prod:down": "docker compose down",
        "prod:logs": "docker compose logs -f",
        "prod:status": "docker compose ps",
        "server:dev": "nodemon server/server.js",
        "deploy:testnet": "npx hardhat run contracts/deploy.js --network bsc_testnet",
        "deploy:mainnet": "npx hardhat run contracts/deploy.js --network bsc_mainnet",
        "compile": "npx hardhat compile",
        "test": "npx hardhat test"
    },
    "keywords": [
        "blockchain",
        "web3",
        "BSC",
        "smart-contract",
        "registration"
    ],
    "author": "PVC Meta Team",
    "license": "MIT",
