        "express": "^4.18.2",
        "express-rate-limit": "^7.1.1",
        "express-validator": "^7.0.1",
        "helmet": "^7.0.0",
        "ioredis": "^5.9.3",
        "jsonwebtoken": "^9.0.2",
        "lucide-react": "^1.45.0",
        "node-cron": "^4.2.1",
        "pg": "^8.18.0",
        "pg-hstore": "^2.3.4",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
